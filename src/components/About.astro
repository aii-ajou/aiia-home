---
import type { AboutView } from "../lib/content/queries";
interface Props {
  about: AboutView;
}
const { about } = Astro.props;
---

<section id="about" class="section about">
  <div class="aiia-container">
    <div class="about__intro">
      <div>
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 class="section__title">{about.title}</h2>
      </div>
      <div>
        <p class="section__lede">{about.lede}</p>
        <a href="#organization" class="text-link">
          연구원 운영 체계 <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
    <div class="pillars">
      {about.pillars.map((p, i) => (
        <article>
          <span class="pillar-index">
            0{i + 1} / {p.mono}
          </span>
          <h3 class="text-subheading">{p.title}</h3>
          <p>{p.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .about {
    border-top: 1px solid var(--aiia-line);
  }
  .about__intro {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: center;
  }
  .about__intro .section__lede {
    margin-bottom: 18px;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 36px;
    gap: 34px;
  }
  .pillars article {
    border-top: 1px solid var(--aiia-line-strong);
    padding-top: 20px;
  }
  .pillar-index {
    font: 500 var(--aiia-text-caption) var(--aiia-font-display);
    color: var(--aiia-ink-mute);
    letter-spacing: 0.08em;
  }
  .pillars h3 {
    margin: 17px 0 9px;
  }
  .pillars p {
    font-size: var(--aiia-text-body);
    color: var(--aiia-ink-soft);
    margin: 0;
  }
  @media (max-width: 720px) {
    .about__intro {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .pillars {
      grid-template-columns: 1fr 1fr;
      gap: 28px 24px;
      margin-top: 32px;
    }
  }
</style>
