---
import type { CenterView } from "../lib/content/queries";
import { linkArrow, siteUrl } from "../lib/url";
interface Props {
  centers: CenterView[];
}
const { centers } = Astro.props;
// 좌우 열을 따로 쌓아 한 항목을 펼쳐도 옆 열이 밀리지 않게 한다 (위→아래, 왼쪽 열 먼저).
const half = Math.ceil(centers.length / 2);
const columns = [centers.slice(0, half), centers.slice(half)].filter(
  (column) => column.length > 0,
);
---

<section id="centers" class="section section--alt">
  <div class="aiia-container">
    <div class="section__head">
      <div>
        <p class="eyebrow">Research & Convergence</p>
        <h2 class="section__title">AI, 전문성을 만나다.</h2>
      </div>
      <p class="centers-note">
        아주의 강점에서 시작하는
        <br />
        다양한 융합 연구 분야
      </p>
    </div>
    <p class="centers-hint">관심 있는 분야를 선택해 연구 내용을 살펴보세요.</p>
    <div class="centers-grid">
      {columns.map((column) => (
        <div class="centers-column">
          {column.map((c) => (
            <details class="center">
              <summary>
                <span class="center__name">
                  <small>{c.en}</small>
                  <strong class="text-subheading">
                    {c.ko.replace("AI+", "")}
                  </strong>
                </span>
                <span class="center__toggle" aria-hidden="true">
                  +
                </span>
              </summary>
              <div class="center__detail">
                <p>{c.desc}</p>
                <span class="center__tags">{c.tag}</span>
                {c.detailUrl && (
                  <a class="text-link" href={siteUrl(c.detailUrl)}>
                    연구 분야 자세히 보기 {linkArrow(c.detailUrl)}
                  </a>
                )}
              </div>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .centers-note {
    font-size: var(--aiia-text-small);
    color: var(--aiia-ink-soft);
    margin: 0 0 3px;
    line-height: 1.8;
  }
  .centers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 52px;
    align-items: start;
  }
  .center {
    border-top: 1px solid var(--aiia-line-strong);
  }
  .center:last-child {
    border-bottom: 1px solid var(--aiia-line-strong);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 24px;
    cursor: pointer;
    padding: 18px 2px;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .center__name {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .center__name small {
    font: 400 var(--aiia-text-caption) var(--aiia-font-display);
    color: var(--aiia-ink-mute);
  }
  .center__toggle {
    margin-left: auto;
    font-size: 24px;
    font-weight: 400;
    color: var(--aiia-primary);
  }
  details[open] .center__toggle {
    transform: rotate(45deg);
  }
  .center__detail {
    padding: 0 var(--aiia-space-6) var(--aiia-space-6) 0;
  }
  .center__detail p {
    font-size: var(--aiia-text-body);
    color: var(--aiia-ink-soft);
  }
  .center__tags {
    font-size: var(--aiia-text-small);
    color: var(--aiia-primary);
  }
  .center__detail a {
    display: flex;
    width: max-content;
    margin-top: 12px;
  }
  .centers-hint {
    font-size: var(--aiia-text-small);
    color: var(--aiia-ink-mute);
    margin: 0 0 var(--aiia-space-4);
  }
  @media (max-width: 640px) {
    .centers-grid {
      grid-template-columns: 1fr;
    }
    .centers-column:not(:last-child) .center:last-child {
      border-bottom: 0;
    }
    .centers-note {
      display: none;
    }
  }
</style>
