---
import type { CenterView } from "../lib/content/queries";
import { siteUrl } from "../lib/url";
interface Props {
  centers: CenterView[];
}
const { centers } = Astro.props;
---

<section id="centers" class="section section--alt">
  <div class="aiia-container">
    <div class="section__head">
      <div>
        <p class="eyebrow">Research & Convergence</p>
        <h2 class="section__title">AI, 전문성을 만나다.</h2>
      </div>
      <p class="centers-note">
        아주의 강점에서 시작하는
        <br />
        여섯 가지 융합 연구 분야
      </p>
    </div>
    <div class="centers-grid">
      {centers.map((c, i) => (
        <details class="center">
          <summary>
            <span class="center__index">0{i + 1}</span>
            <span class="center__name">
              <small>{c.en}</small>
              <strong class="text-subheading">{c.ko.replace("AI+", "")}</strong>
            </span>
            <span class="center__toggle" aria-hidden="true">
              +
            </span>
          </summary>
          <div class="center__detail">
            <p>{c.desc}</p>
            <span class="center__tags">{c.tag}</span>
            {c.detailUrl && (
              <a class="text-link" href={siteUrl(c.detailUrl)}>
                연구센터 방문 ↗
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
    <p class="centers-footnote">
      관심 있는 분야를 선택해 연구 내용을 살펴보세요.
    </p>
  </div>
</section>
<style>
  .centers-note {
    font-size: var(--aiia-text-small);
    color: var(--aiia-ink-soft);
    margin: 0 0 3px;
    line-height: 1.8;
  }
  .centers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 52px;
    align-items: start;
  }
  .center {
    border-top: 1px solid var(--aiia-line-strong);
  }
  .center:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--aiia-line-strong);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 24px;
    cursor: pointer;
    padding: 18px 2px;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .center__index {
    font: 400 var(--aiia-text-caption) var(--aiia-font-display);
    color: var(--aiia-ink-mute);
  }
  .center__name {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .center__name small {
    font: 400 var(--aiia-text-caption) var(--aiia-font-display);
    color: var(--aiia-ink-mute);
  }
  .center__toggle {
    margin-left: auto;
    font-size: 24px;
    font-weight: 400;
    color: var(--aiia-primary);
  }
  details[open] .center__toggle {
    transform: rotate(45deg);
  }
  .center__detail {
    padding: 0 28px 25px 39px;
  }
  .center__detail p {
    font-size: var(--aiia-text-body);
    color: var(--aiia-ink-soft);
  }
  .center__tags {
    font-size: var(--aiia-text-small);
    color: var(--aiia-primary);
  }
  .center__detail a {
    display: flex;
    width: max-content;
    margin-top: 12px;
  }
  .centers-footnote {
    font-size: var(--aiia-text-small);
    color: var(--aiia-ink-mute);
    margin: 24px 0 0;
  }
  @media (max-width: 640px) {
    .centers-grid {
      grid-template-columns: 1fr;
    }
    .center:nth-last-child(2) {
      border-bottom: 0;
    }
    .centers-note {
      display: none;
    }
  }
</style>
