---
import type { ContactView } from "../lib/content/queries";
import { siteUrl } from "../lib/url";
import EmailText from "./EmailText.astro";
interface Props {
  contact: ContactView;
}
const { contact } = Astro.props;
---

<section id="contact" class="contact aiia-container">
  <div>
    <p class="eyebrow">{contact.eyebrow}</p>
    <h2 class="section__title">{contact.title}</h2>
  </div>
  <div class="contact__items">
    {contact.items.map((c) => (
      <p>
        <span>{c.label}</span>
        <strong>
          <EmailText text={c.value} />
        </strong>
      </p>
    ))}
  </div>
  <a
    href="https://www.ajou.ac.kr/kr/intro/way01.do"
    class="text-link"
    target="_blank"
    rel="noopener noreferrer"
  >
    캠퍼스 안내 <span aria-hidden="true">↗</span>
  </a>
  {contact.mapImage && (
    <img
      src={siteUrl(contact.mapImage)}
      alt="연구원 위치 안내 지도"
      loading="lazy"
    />
  )}
</section>
<style>
  .contact {
    padding-block: var(--aiia-section-space);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    flex-wrap: wrap;
  }
  .contact .eyebrow {
    margin-bottom: 8px;
  }
  .contact h2 {
    margin: 0;
  }
  .contact__items {
    display: flex;
    gap: 50px;
  }
  .contact__items p {
    margin: 0;
    font-size: var(--aiia-text-body);
  }
  .contact__items span {
    display: block;
    font: 500 var(--aiia-text-caption) var(--aiia-font-display);
    color: var(--aiia-ink-mute);
    margin-bottom: 9px;
  }
  .contact__items strong {
    font-weight: 400;
    white-space: pre-line;
  }
  .contact > img {
    width: 100%;
    max-height: 350px;
    object-fit: contain;
  }
  @media (max-width: 720px) {
    .contact {
      align-items: flex-start;
      gap: 24px;
    }
    .contact__items {
      flex-direction: column;
      gap: 20px;
    }
    .contact > .text-link {
      margin-left: auto;
    }
  }
</style>
