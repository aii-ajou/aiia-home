---
import type { FooterView } from "../lib/content/queries";
import { siteUrl, withBase } from "../lib/url";
import EmailText from "./EmailText.astro";
interface Props {
  footer: FooterView;
}
const { footer } = Astro.props;
---

<footer class="footer">
  <div class="aiia-container">
    <div class="footer__top">
      <a href={withBase("")} class="footer__brand">
        <img
          src={siteUrl("/brand/aiia-symbol.png")}
          alt=""
          width="25"
          height="31"
        />
        <span>
          <strong>AIIA</strong>
          <span>아주대학교 인공지능연구원</span>
        </span>
      </a>
      <div class="footer__links">
        <a
          href="https://www.ajou.ac.kr/kr/index.do"
          target="_blank"
          rel="noopener noreferrer"
        >
          아주대학교 ↗
        </a>
        <a
          href="https://www.ajou.ac.kr/kr/etc/privacy.do"
          target="_blank"
          rel="noopener noreferrer"
        >
          개인정보처리방침 ↗
        </a>
        <a href={withBase("admin/")}>관리자</a>
      </div>
    </div>
    <p class="footer__address">
      <EmailText text={footer.addressHtml} />
    </p>
    <div class="footer__bottom">
      <span>{footer.copyright}</span>
      <a
        href="#top"
        onclick="window.scrollTo({top:0});return false"
        aria-label="맨 위로 이동"
      >
        맨 위로 ↑
      </a>
    </div>
  </div>
</footer>

<style>
  .footer__address {
    white-space: pre-line;
    font-size: var(--aiia-text-caption);
    color: var(--aiia-ink-mute);
    margin: 0 0 24px;
  }
  .footer {
    border-top: 1px solid var(--aiia-line);
    padding: 36px 0 24px;
    background: var(--aiia-bg-alt);
  }
  .footer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding-bottom: 30px;
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer__brand > span {
    display: flex;
    align-items: center;
    gap: 15px;
  }
  .footer__brand strong {
    font: 700 23px var(--aiia-font-display);
    color: var(--aiia-primary);
  }
  .footer__brand span span {
    font-size: var(--aiia-text-caption);
  }
  .footer__links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-size: var(--aiia-text-small);
    color: var(--aiia-ink-soft);
  }
  .footer__bottom {
    border-top: 1px solid var(--aiia-line);
    padding-top: 20px;
    display: flex;
    align-items: center;
    gap: 25px;
    color: var(--aiia-ink-mute);
    font-size: var(--aiia-text-small);
  }
  .footer__bottom > span {
    margin-right: auto;
    font: 400 var(--aiia-text-caption) var(--aiia-font-display);
  }
  @media (max-width: 720px) {
    .footer__top {
      align-items: flex-start;
      flex-direction: column;
    }
    .footer__bottom {
      flex-wrap: wrap;
      gap: 10px 20px;
    }
    .footer__bottom > span {
      width: 100%;
    }
    .footer__brand > span {
      gap: 10px;
    }
  }
</style>
