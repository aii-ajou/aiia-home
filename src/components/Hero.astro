---
import type { HeroView } from "../lib/content/queries";
import { siteUrl } from "../lib/url";
interface Props {
  hero: HeroView;
}
const { hero } = Astro.props;
---

<section id="top" class="hero aiia-container">
  <div class="hero__copy">
    <p class="eyebrow">
      <span class="hero__dot"></span>
      {hero.eyebrow}
    </p>
    <h1 class="text-heading">{hero.title}</h1>
    <p class="hero__lede text-body">{hero.lede}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={siteUrl(hero.ctaPrimary.href)}>
        {hero.ctaPrimary.label}
        <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href={siteUrl(hero.ctaSecondary.href)}>
        {hero.ctaSecondary.label}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
  <figure class="hero__visual">
    {hero.visual && (
      <img
        src={siteUrl(hero.visual)}
        alt={hero.visualAlt}
        width="600"
        height="620"
        fetchpriority="high"
      />
    )}
    <figcaption>
      <span>{hero.visualCaption}</span>
      <span aria-hidden="true">37.283° N · 127.046° E</span>
    </figcaption>
    <span class="hero__image-label" aria-hidden="true">
      A place for
      <br />
      new possibilities.
    </span>
  </figure>
</section>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.06fr 1fr;
    gap: 52px;
    align-items: center;
    padding-block: 40px;
  }
  .hero__copy {
    padding-block: 25px;
  }
  .hero__copy .eyebrow {
    font-size: var(--aiia-text-caption);
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 0.12em;
    margin-bottom: 28px;
  }
  .hero__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--aiia-primary);
  }
  h1 {
    margin: 0 0 28px;
  }
  .hero__lede {
    white-space: pre-line;
    color: var(--aiia-ink-soft);
    margin-bottom: 24px;
  }
  .hero__actions {
    display: flex;
    gap: 25px;
    align-items: center;
    flex-wrap: wrap;
  }
  .hero__visual {
    position: relative;
    margin: 0;
    padding: 0 0 29px;
  }
  .hero__visual > img {
    width: 100%;
    height: 430px;
    object-fit: cover;
    object-position: 53% center;
    border-radius: 150px 3px 3px 3px;
  }
  .hero__visual figcaption {
    position: absolute;
    bottom: 0;
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: var(--aiia-text-caption);
    color: var(--aiia-ink-mute);
  }
  .hero__image-label {
    position: absolute;
    bottom: 55px;
    left: 26px;
    font: 500 var(--aiia-text-subheading)/1.5 var(--aiia-font-sans);
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 0 1px 12px #0009;
  }
  @media (max-width: 1000px) {
    .hero {
      gap: 30px;
    }
    .hero__visual > img {
      height: 390px;
    }
    .hero__lede {
      white-space: normal;
    }
  }
  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 28px 32px;
      gap: 24px;
    }
    h1 {
      margin-bottom: 20px;
    }
    .hero__copy {
      padding: 0;
    }
    .hero__copy .eyebrow {
      margin-bottom: 20px;
      font-size: var(--aiia-text-caption);
    }
    .hero__visual > img {
      height: 270px;
      border-top-left-radius: 90px;
    }
    .hero__lede {
      margin-bottom: 24px;
      max-width: 450px;
    }
    .hero__actions {
      gap: 18px;
    }
  }
</style>
