---
import type { InquiryView } from "../lib/content/queries";
interface Props {
  inquiry: InquiryView;
  email: string;
}
const { inquiry, email } = Astro.props;
---

<section id="inquiry" class="section inquiry">
  <div class="aiia-container inquiry__inner">
    <div>
      <p class="eyebrow">{inquiry.eyebrow}</p>
      <h2 class="section__title">{inquiry.title}</h2>
      <p class="section__lede">{inquiry.lede}</p>
    </div>
    <div class="inquiry__actions">
      <ul>
        {inquiry.coopModes.map((m) => (
          <li>
            {m}
            <span aria-hidden="true">↗</span>
          </li>
        ))}
      </ul>
      <a
        class="btn btn--primary"
        href={`mailto:${email}?subject=${encodeURIComponent("[AIIA 협력 문의]")}`}
      >
        {inquiry.submitLabel}
        <span aria-hidden="true">↗</span>
      </a>
      <p>{email}</p>
    </div>
  </div>
</section>
<style>
  .inquiry {
    background: var(--aiia-brand-tint);
  }
  .inquiry__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: center;
  }
  .section__lede {
    font-size: var(--aiia-text-body);
    margin: 22px 0 0;
  }
  .inquiry__actions ul {
    list-style: none;
    padding: 0;
    margin: 0 0 28px;
  }
  .inquiry__actions li {
    border-bottom: 1px solid var(--aiia-line-strong);
    padding: 13px 0;
    display: flex;
    justify-content: space-between;
    font-size: var(--aiia-text-body);
  }
  .inquiry__actions li span {
    color: var(--aiia-primary);
  }
  .inquiry__actions > p {
    font: 400 var(--aiia-text-small) var(--aiia-font-display);
    color: var(--aiia-ink-soft);
    margin: 12px 0;
    display: block;
  }
  @media (max-width: 720px) {
    .inquiry__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
