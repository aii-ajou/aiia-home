---
import type { MemberView } from "../lib/content/queries";
import MemberCard from "./MemberCard.astro";
import { withBase } from "../lib/url";
interface Props {
  members: MemberView[];
}
const { members } = Astro.props;
const featured = [...members]
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 5);
---

<section id="members" class="section">
  <div class="aiia-container">
    <div class="section__head">
      <div>
        <p class="eyebrow">People of AIIA</p>
        <h2 class="section__title">새로운 가능성을 여는 사람들</h2>
      </div>
      <a class="section__link" href={withBase("members/")}>
        연구자 전체 보기 <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="members-intro">서로 다른 전문성, 함께하는 하나의 도전.</p>
    <div class="members-grid">
      {featured.map((member) => (
        <MemberCard member={member} />
      ))}
    </div>
  </div>
</section>
<style>
  .members-intro {
    color: var(--aiia-ink-soft);
    font-size: var(--aiia-text-body);
    margin: 0 0 24px;
  }
  .members-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, 220px);
    gap: 28px 16px;
  }
  @media (max-width: 560px) {
    .members-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 12px;
    }
    .section__head {
      align-items: flex-start;
    }
  }
</style>
