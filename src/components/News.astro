---
import type { NewsView } from "../lib/content/queries";
import NewsCard from "./NewsCard.astro";
import { withBase } from "../lib/url";
interface Props {
  news: NewsView[];
}
const { news } = Astro.props;
---

<section id="news" class="section section--alt">
  <div class="aiia-container">
    <div class="section__head">
      <div>
        <p class="eyebrow">News & Stories</p>
        <h2 class="section__title">연구원의 오늘</h2>
      </div>
      <a class="section__link" href={withBase("news/")}>
        모든 소식 보기 <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="news-grid">
      {news.slice(0, 3).map((n, index) => (
        <NewsCard news={n} index={index} />
      ))}
    </div>
  </div>
</section>
<style>
  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  @media (max-width: 720px) {
    .news-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
