---
import type { OrganizationView } from "../lib/content/queries";
interface Props {
  organization: OrganizationView;
}
const { organization: o } = Astro.props;
---

<section id="organization" class="organization aiia-container">
  <details>
    <summary>
      <span>
        <span class="eyebrow">{o.eyebrow}</span>
        <strong>{o.title}</strong>
      </span>
      <span class="org-open">
        자세히 보기 <b aria-hidden="true">+</b>
      </span>
    </summary>
    <div class="organization__body">
      <p class="section__lede">{o.lede}</p>
      <div class="org-leaders">
        {o.leadership.map((l) => (
          <article>
            <small>{l.label}</small>
            <h3>{l.person}</h3>
            <p>{l.note}</p>
          </article>
        ))}
      </div>
      <h3>연구기획 TF</h3>
      <div class="org-grid">
        {o.functions.map((f) => (
          <article>
            <h4>{f.title}</h4>
            <p>{f.desc}</p>
          </article>
        ))}
      </div>
      <h3>연구센터 운영</h3>
      <div class="org-grid">
        {o.centerGroups.map((g) => (
          <article>
            <h4>{g.title}</h4>
            <p>{g.desc}</p>
          </article>
        ))}
      </div>
      <h3>기업 파트너십</h3>
      <div class="org-grid">
        {o.tiers.map((t) => (
          <article>
            <small>{t.tier}</small>
            <h4>{t.name}</h4>
            <p>{t.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </details>
</section>
<style>
  .organization {
    padding-block: 0 var(--aiia-section-space);
  }
  .organization details {
    border-block: 1px solid var(--aiia-line);
  }
  .organization summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
  }
  .organization summary::-webkit-details-marker {
    display: none;
  }
  summary > span:first-child {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .eyebrow {
    margin: 0;
  }
  summary strong {
    font-size: var(--aiia-text-subheading);
    font-weight: 500;
  }
  .org-open {
    font-size: var(--aiia-text-control);
    display: flex;
    align-items: center;
    gap: 22px;
    color: var(--aiia-ink-soft);
  }
  .org-open b {
    font-weight: 400;
    font-size: 22px;
  }
  details[open] .org-open b {
    transform: rotate(45deg);
  }
  .organization__body {
    padding: 10px 0 36px;
  }
  .organization__body > h3 {
    font-size: var(--aiia-text-subheading);
    font-weight: 500;
    margin-top: 28px;
  }
  .org-leaders,
  .org-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .org-leaders article,
  .org-grid article {
    background: var(--aiia-bg-alt);
    padding: 22px;
  }
  .org-leaders h3 {
    font-size: var(--aiia-text-subheading);
    font-weight: 500;
    margin: 8px 0;
  }
  .organization p {
    font-size: var(--aiia-text-body);
  }
  .organization small {
    font-size: var(--aiia-text-caption);
    color: var(--aiia-primary);
  }
  .org-grid h4 {
    font-size: var(--aiia-text-subheading);
    margin: 8px 0;
    font-weight: 500;
  }
  @media (max-width: 720px) {
    summary > span:first-child {
      display: block;
    }
    .eyebrow {
      display: block;
      margin-bottom: 10px;
    }
    .org-open {
      white-space: nowrap;
    }
    .org-leaders,
    .org-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
