---
import type { OrganizationView } from "../lib/content/queries";
import { relationLabels } from "../lib/content/organization";
import { linkArrow, siteUrl } from "../lib/url";
import OrganizationChart from "./OrganizationChart.astro";
interface Props {
  organization: OrganizationView;
}
const { organization: o } = Astro.props;
const centers = o.nodes.filter(
  (node) => node.relation === "d" || node.relation === "i",
);
const supporting = o.nodes.filter(
  (node) =>
    !["d", "i", "h"].includes(node.relation) &&
    (node.description || node.photo),
);
// 마지막 줄에 카드 하나만 남지 않도록 열 수를 고른다 (4개 → 4열, 7개 → 4+3).
const columnsFor = (count: number) =>
  count > 1 && (count % 4 === 0 || count % 3 === 1) ? 4 : 3;
// 사진이 있는 카드와 섞이면 사진 없는 카드에도 같은 크기의 자리표시를 둔다.
const anyPhoto = (nodes: typeof o.nodes) => nodes.some((node) => node.photo);
const centersHavePhoto = anyPhoto(centers);
const supportingHavePhoto = anyPhoto(supporting);
---

<section
  id="organization"
  class="section organization aiia-container"
  aria-labelledby="organization-title"
>
  <div class="section__head">
    <div>
      <p class="eyebrow">{o.eyebrow}</p>
      <h2 id="organization-title" class="section__title">
        {o.title}
      </h2>
    </div>
  </div>
  <p class="section__lede">{o.lede}</p>
  <OrganizationChart organization={o} />
  {centers.length > 0 && (
    <div class="org-centers">
      <div class="org-subhead">
        <h3>연구센터</h3>
        <p>각 센터의 역할을 살펴보세요.</p>
      </div>
      <div class="org-cards" style={`--org-cols:${columnsFor(centers.length)}`}>
        {centers.map((node) => (
          <article class="org-card" data-center-name={node.name}>
            {node.photo ? (
              <img
                src={siteUrl(node.photo)}
                alt={`${node.name} 소개`}
                loading="lazy"
                width="600"
                height="360"
              />
            ) : (
              centersHavePhoto && (
                <div class="org-card__placeholder" aria-hidden="true">
                  <img
                    src={siteUrl("/brand/aiia-symbol.png")}
                    alt=""
                    width="34"
                    height="42"
                  />
                </div>
              )
            )}
            {node.relation !== "d" && (
              <span class="org-kind">{relationLabels[node.relation]}</span>
            )}
            <h4>
              {node.detailUrl ? (
                <a href={siteUrl(node.detailUrl)}>
                  {node.name} {linkArrow(node.detailUrl)}
                </a>
              ) : (
                node.name
              )}
            </h4>
            {node.leader && <p class="org-leader">책임자 · {node.leader}</p>}
            {node.description && (
              <p class="org-description">{node.description}</p>
            )}
          </article>
        ))}
      </div>
    </div>
  )}
  {supporting.length > 0 && (
    <details class="org-more">
      <summary>
        협력기관·운영 조직 소개
        <span class="org-more__toggle" aria-hidden="true">
          +
        </span>
      </summary>
      <div
        class="org-cards"
        style={`--org-cols:${columnsFor(supporting.length)}`}
      >
        {supporting.map((node) => (
          <article class="org-card">
            {node.photo ? (
              <img
                src={siteUrl(node.photo)}
                alt={`${node.name} 소개`}
                loading="lazy"
                width="600"
                height="360"
              />
            ) : (
              supportingHavePhoto && (
                <div class="org-card__placeholder" aria-hidden="true">
                  <img
                    src={siteUrl("/brand/aiia-symbol.png")}
                    alt=""
                    width="34"
                    height="42"
                  />
                </div>
              )
            )}
            <span class="org-kind">{relationLabels[node.relation]}</span>
            <h4>{node.name}</h4>
            {node.leader && <p class="org-leader">책임자 · {node.leader}</p>}
            <p class="org-description">{node.description}</p>
            {node.detailUrl && (
              <a href={siteUrl(node.detailUrl)}>
                자세히 보기 {linkArrow(node.detailUrl)}
              </a>
            )}
          </article>
        ))}
      </div>
    </details>
  )}
  {(o.functions.length > 0 || o.tiers.length > 0) && (
    <details class="org-more">
      <summary>
        연구기획 및 파트너십 운영모델
        <span class="org-more__toggle" aria-hidden="true">
          +
        </span>
      </summary>
      {o.functions.length > 0 && (
        <>
          <h3>연구기획 TF</h3>
          <div class="org-cards">
            {o.functions.map((item) => (
              <article class="org-card">
                <h4>{item.title}</h4>
                <p>{item.desc}</p>
              </article>
            ))}
          </div>
        </>
      )}
      {o.tiers.length > 0 && (
        <>
          <h3>기업 파트너십</h3>
          <div class="org-cards">
            {o.tiers.map((item) => (
              <article class="org-card">
                <span class="org-kind">{item.tier}</span>
                <h4>{item.name}</h4>
                <p>{item.detail}</p>
              </article>
            ))}
          </div>
        </>
      )}
    </details>
  )}
</section>
<style>
  .organization > .section__lede {
    max-width: none;
    margin-bottom: var(--aiia-space-8);
  }
  .org-centers {
    margin-top: var(--aiia-space-12);
  }
  .org-subhead {
    display: flex;
    align-items: baseline;
    gap: var(--aiia-space-4);
    margin-bottom: var(--aiia-space-6);
  }
  .org-subhead h3,
  .org-more h3 {
    font-size: var(--aiia-text-subheading);
    font-weight: 500;
    margin: 0;
  }
  .org-subhead p {
    font-size: var(--aiia-text-small);
    color: var(--aiia-ink-soft);
    margin: 0;
  }
  .org-cards {
    display: grid;
    grid-template-columns: repeat(var(--org-cols, 3), minmax(0, 1fr));
    gap: var(--aiia-space-6);
  }
  .org-card {
    border-top: 2px solid var(--aiia-line-strong);
    padding: var(--aiia-space-6);
    background: var(--aiia-bg-alt);
    overflow-wrap: anywhere;
  }
  .org-card h4 {
    font-size: var(--aiia-text-subheading);
    line-height: 1.5;
    font-weight: 500;
    margin: var(--aiia-space-2) 0 var(--aiia-space-3);
  }
  .org-card p {
    font-size: var(--aiia-text-small);
    margin: 0;
    color: var(--aiia-ink-soft);
    white-space: pre-line;
  }
  .org-card .org-leader {
    margin-bottom: var(--aiia-space-3);
    color: var(--aiia-primary);
  }
  .org-kind {
    font-size: var(--aiia-text-caption);
    color: var(--aiia-primary);
  }
  .org-card > img,
  .org-card__placeholder {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    border-radius: var(--aiia-r-sm);
    margin-bottom: var(--aiia-space-4);
  }
  .org-card__placeholder {
    display: grid;
    place-items: center;
    background: var(--aiia-surface-2);
  }
  .org-card__placeholder img {
    opacity: 0.35;
  }
  .org-more {
    border-top: 1px solid var(--aiia-line);
    margin-top: var(--aiia-space-8);
  }
  .org-more summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--aiia-space-6);
    cursor: pointer;
    padding-block: var(--aiia-space-6);
    font-size: var(--aiia-text-control);
    list-style: none;
  }
  .org-more summary::-webkit-details-marker {
    display: none;
  }
  .org-more__toggle {
    font-size: 24px;
    font-weight: 400;
    line-height: 1;
    color: var(--aiia-primary);
  }
  .org-more[open] .org-more__toggle {
    transform: rotate(45deg);
  }
  .org-more h3 {
    margin-block: var(--aiia-space-4);
  }
  @media (max-width: 900px) {
    .org-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .org-cards {
      grid-template-columns: 1fr;
    }
    .org-subhead {
      display: block;
    }
    .org-subhead p {
      margin-top: var(--aiia-space-2);
    }
  }
</style>
