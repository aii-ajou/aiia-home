---
import "../styles/global.css";
import { siteUrl } from "../lib/url";
interface Props {
  title?: string;
  description?: string;
  lang?: "ko" | "en";
  ogImage?: string;
  noindex?: boolean;
}
const {
  title = "아주대학교 인공지능연구원 · AIIA",
  description = "아주대학교의 전문성과 AI를 연결해 의미 있는 변화를 만듭니다.",
  lang = "ko",
  ogImage = "/uploads/ajou-campus.webp",
  noindex = false,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://aiia.ajou.ac.kr",
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link
      rel="icon"
      type="image/png"
      href={siteUrl("/brand/aiia-symbol.png")}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(siteUrl(ogImage), Astro.site ?? canonical).href}
    />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&family=Noto+Serif+KR:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("aiia-theme") === "dark" ? "dark" : "light";
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      본문 바로가기
    </a>
    <slot />
  </body>
</html>
<script>
  document
    .querySelectorAll<HTMLImageElement>("img[data-fallback]")
    .forEach((img) => {
      const fallback = () => {
        img.hidden = true;
        img.parentElement?.classList.add("image-unavailable");
      };
      img.addEventListener("error", fallback);
      if (img.complete && img.currentSrc && !img.naturalWidth) fallback();
    });
</script>
