---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { loadHomePageData, loadNewsDetails } from "../../lib/content/queries";
import { siteUrl, withBase } from "../../lib/url";
export async function getStaticPaths() {
  const [data, news] = await Promise.all([
    loadHomePageData(),
    loadNewsDetails(),
  ]);
  return news.map((n) => ({
    params: { slug: n.slug },
    props: { news: n, data },
  }));
}
const { news: n, data } = Astro.props;
---

<Base
  title={`${n.title} · ${data.site.title}`}
  description={n.summary || n.body?.slice(0, 120)}
  ogImage={n.thumbnail ?? undefined}
>
  <Header nav={data.nav} cta={data.site.headerCta} />
  <main id="main" class="aiia-container news-detail">
    <a href={withBase("news/")} class="text-link">
      ← 소식 목록
    </a>
    <article>
      <div class="news-detail__meta">
        <span class="tag">{n.cat}</span>
        <time datetime={n.dateISO}>{n.dateDisplay}</time>
        <span>{n.sourceName}</span>
      </div>
      <h1 class="text-heading">{n.title}</h1>
      {n.thumbnail && (
        <img
          class="article-image"
          src={siteUrl(n.thumbnail)}
          alt=""
          width="1200"
          height="760"
        />
      )}
      {n.body ? (
        <div class="article-body">
          {n.body.split(/\n\n+/).map((p) => (
            <p>{p}</p>
          ))}
        </div>
      ) : (
        <p>자세한 내용은 원문에서 확인해 주세요.</p>
      )}
      {n.sourceUrl && (
        <aside class="source">
          <div>
            <small>출처</small>
            <strong>{n.sourceName || new URL(n.sourceUrl).hostname}</strong>
          </div>
          <a
            class="btn"
            href={n.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            원문 읽기 ↗
          </a>
        </aside>
      )}
      {n.attachment && (
        <a class="text-link" href={siteUrl(n.attachment)} download>
          첨부파일 내려받기 ↓
        </a>
      )}
    </article>
    <a href={withBase("news/")} class="text-link">
      모든 소식 보기 →
    </a>
  </main>
  <Footer footer={data.footer} />
</Base>
<style>
  .news-detail {
    max-width: 820px;
    padding-block: 32px var(--aiia-section-space);
  }
  .news-detail article {
    padding-block: 40px 48px;
  }
  .news-detail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    font-size: var(--aiia-text-caption);
    color: var(--aiia-ink-mute);
  }
  .news-detail h1 {
    margin: 24px 0 36px;
  }
  .article-image {
    width: 100%;
    height: auto;
    margin-bottom: 36px;
  }
  .article-body {
    font-size: var(--aiia-text-body);
    line-height: var(--aiia-leading-body);
    color: var(--aiia-ink-soft);
  }
  .article-body p {
    white-space: pre-line;
  }
  .source {
    margin-top: 36px;
    padding: 24px;
    background: var(--aiia-bg-alt);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .source small {
    display: block;
    font-size: var(--aiia-text-caption);
    color: var(--aiia-ink-mute);
  }
  .source strong {
    font-size: var(--aiia-text-body);
    font-weight: 500;
  }
</style>
